# Porta do hub. Em produção o processo lê PORT.
PORT=3000

# A sessão desta demo é local: o servidor emite um cookie para um membro do workspace.
# Produção recusa esse modo sem a variável abaixo.
HUB_ALLOW_LOCAL_DEV=true

# Caminhos opcionais. Fora dessas variáveis, o hub usa data/ no diretório atual.
# HUB_LEDGER_PATH=/data/hub-ledger.json
# HUB_SESSION_KEY_PATH=/data/hub-session.key
